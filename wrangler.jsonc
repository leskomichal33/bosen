{
  // Web Michala Leška – Cloudflare Worker „bosen“
  "name": "bosen",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // index.html sa načíta ako text a Worker do neho doplní aktuálnu ponuku z bosen.sk
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.css"], "fallthrough": true },
    // Fotky, certifikát a písma sa servírujú priamo z Workera (/img/…, /fonts/…)
    { "type": "Data", "globs": ["**/*.jpg", "**/*.png", "**/*.woff2"], "fallthrough": true }
  ],
  // Uložená ponuka z bosen.sk (obnovuje sa raz denne)
  // Workers AI – automatický preklad názvov nových inzerátov do angličtiny a nemčiny
  "ai": { "binding": "AI" },
  // Databáza BOREA – ocenenie z nej iba ČÍTA porovnateľné inzeráty (skript BOREA sa nemení)
  "d1_databases": [{ "binding": "BOREA_DB", "database_name": "bosen-reality-db", "database_id": "3808ee13-4390-45b2-a2e4-84f02cdc0e00" }],
  "kv_namespaces": [{ "binding": "PONUKA", "id": "37102f2c3a6c4a22bfd5cd14f31ec815" }],
  // Každý deň o 4:00 UTC (5:00 v zime / 6:00 v lete na Slovensku)
  "triggers": { "crons": ["0 4 * * *", "*/15 * * * *"] },
  "observability": { "enabled": true }
}
